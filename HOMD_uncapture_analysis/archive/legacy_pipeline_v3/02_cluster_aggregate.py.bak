#!/usr/bin/env python3
"""
pipeline_v3 Step 02: Cluster aggregation + HOMD novelty classification.

TreeCluster clusters (Step 01) replace the v2 phylotype units. This step
aggregates per-cluster support statistics from the ASV-level metadata and
classifies each cluster's HOMD novelty:

  cluster_novelty_class:
    homd_captured   - >=1 member ASV is covered (nearest HOMD-species reference
                      within 0.03 on the GG2 tree) OR the rep ASV has >=97%
                      identity to an HOMD reference sequence (v2 safety net).
    homd_uncaptured - otherwise -> candidate new lineage.

  candidate_novel: homd_uncaptured AND max_subject_prevalence >= 10
                   (distinct (bioproject, subject_id) individuals, v2 gate).

Inputs:
  - asv_clusters.tsv                  : ASV -> cluster + tree annotation (v3)
  - pipeline_v2/04_support_floor_passed.tsv : support metadata
  - pipeline_v2/01b_derep_subject_prevalence.tsv : subject prevalence
  - pipeline_v2/01_chimera_filtered.tsv : HOMD identity (safety net)
  - HOMD_16S_rRNA_RefSeq_V16.03_full.fasta

Outputs:
  - 02_clusters_aggregated.tsv : per-cluster table
  - 02_summary.json
"""
import json
import os
import re
from pathlib import Path

import numpy as np
import pandas as pd

BASE = Path("/beegfs/huangxiaochang/global_oral/global-oral-microbiome/HOMD_uncapture_analysis")
PIPE_V3 = BASE / "pipeline_v3"
PIPE_V2 = BASE / "pipeline_v2"
HOMD_FASTA = Path("/beegfs/huangxiaochang/global_oral/HOMD_16S_rRNA_RefSeq_V16.03_full.fasta")
log = lambda s: print(f"[02_cluster_agg] {s}", flush=True)


def parse_set(val):
    if pd.isna(val) or val == "":
        return set()
    s = str(val).strip("{}")
    for sep in ["; ", ";", ", ", ","]:
        if sep in s:
            return set(x.strip().strip("'\"") for x in s.split(sep))
    return {s.strip().strip("'\"")}


def load_homd_catalog():
    homd_genus, homd_species = set(), set()
    with open(HOMD_FASTA) as f:
        for line in f:
            if line.startswith(">"):
                parts = line.split()
                if len(parts) >= 3:
                    homd_genus.add(parts[2].strip())
                    if len(parts) >= 4:
                        homd_species.add(f"{parts[2].strip()} {parts[3].strip()}")
    return homd_genus, homd_species


def main():
    # 1. ASV -> cluster + annotation
    log("Loading asv_clusters.tsv ...")
    asv = pd.read_csv(PIPE_V3 / "asv_clusters.tsv", sep="\t", low_memory=False)
    asv["asv_id"] = asv["asv_id"].astype(str)
    log(f"  {len(asv):,} ASVs")

    # 2. Support metadata
    log("Loading v2 support metadata ...")
    s04 = pd.read_csv(PIPE_V2 / "04_support_floor_passed.tsv", sep="\t", low_memory=False)
    s04["derep_id"] = s04["derep_id"].astype(str)
    subj = pd.read_csv(PIPE_V2 / "01b_derep_subject_prevalence.tsv", sep="\t",
                       low_memory=False, usecols=["derep_id", "subject_prevalence"])
    subj["derep_id"] = subj["derep_id"].astype(str)
    s04 = s04.merge(subj, on="derep_id", how="left")
    s04["subject_prevalence"] = pd.to_numeric(s04["subject_prevalence"], errors="coerce").fillna(0).astype(int)
    log(f"  support metadata: {len(s04):,} ASVs")

    # 3. HOMD identity safety net (v2 step 01)
    h01 = pd.read_csv(PIPE_V2 / "01_chimera_filtered.tsv", sep="\t", low_memory=False,
                      usecols=["derep_id", "identity", "homd_target", "has_homd_hit"])
    h01["derep_id"] = h01["derep_id"].astype(str)
    h01 = h01.rename(columns={"identity": "homd_identity"})
    s04 = s04.merge(h01, on="derep_id", how="left")

    # 4. Merge
    df = asv.merge(s04, left_on="asv_id", right_on="derep_id", how="left")
    n_unmatched = df["derep_id"].isna().sum()
    if n_unmatched:
        log(f"  WARNING: {n_unmatched} ASVs without support metadata")
    df["covered"] = df["covered"].astype(str).str.lower().isin(["true", "1", "t"])
    df["homd_identity"] = pd.to_numeric(df["homd_identity"], errors="coerce")
    df["covered_safety"] = df["covered"] | (df["homd_identity"] >= 97.0)

    # 5. Per-cluster aggregation
    log("Aggregating per cluster ...")
    g = df.groupby("cluster_id")
    agg = pd.DataFrame({
        "cluster_id": g.size().index,
        "n_asvs": g.size().values,
        "n_refs_in_cluster": g["n_refs_in_cluster"].first().values,
        "rep_derep_id": g.apply(lambda x: x.loc[x["subject_prevalence"].idxmax(), "asv_id"]).values,
        "member_derep_ids": g["asv_id"].apply(lambda x: ";".join(x)).values,
        "annotation": g["annotation"].first().values,
        "annotation_level": g["annotation_level"].first().values,
        "annotation_basis": g["annotation_basis"].first().values,
        "n_covered": g["covered"].sum().values,
        "n_covered_safety": g["covered_safety"].sum().values,
        "any_covered": g["covered"].any().values,
        "any_covered_safety": g["covered_safety"].any().values,
        "total_reads_sum": g["total_reads"].sum().values,
        "max_n_bioprojects": g["n_bioprojects"].max().values,
        "max_prevalence": g["prevalence_samples"].max().values,
        "max_subject_prevalence": g["subject_prevalence"].max().values,
        "n_contaminated_asvs": g["contamination_flag"].apply(
            lambda x: int(x.astype(str).str.lower().isin(["true", "1", "t"]).sum())).values,
    })
    agg["any_contamination"] = agg["n_contaminated_asvs"] > 0
    agg["clean_cluster"] = ~agg["any_contamination"]

    # regions / bioprojects / continents per cluster
    agg["regions"] = g["amplicon_regions"].apply(
        lambda x: ";".join(sorted(set(r for v in x.dropna() for r in parse_set(v))))).values
    agg["n_regions"] = agg["regions"].apply(lambda s: len(parse_set(s)))
    agg["bioprojects"] = g["bioprojects"].apply(
        lambda x: ";".join(sorted(set(r for v in x.dropna() for r in parse_set(v))))).values
    agg["n_bioprojects_total"] = agg["bioprojects"].apply(lambda s: len(parse_set(s)))
    agg["continents"] = g["continents"].apply(
        lambda x: ";".join(sorted(set(r for v in x.dropna() for r in parse_set(v))))).values
    agg["n_continents"] = agg["continents"].apply(lambda s: len(parse_set(s)))

    # 6. Novelty classification
    log("Classifying cluster novelty ...")
    agg["cluster_novelty_class"] = np.where(agg["any_covered_safety"], "homd_captured", "homd_uncaptured")
    agg["candidate_novel"] = (agg["cluster_novelty_class"] == "homd_uncaptured") & (agg["max_subject_prevalence"] >= 10)

    # rep-level HOMD identity
    rep_map = df.set_index("asv_id")[["homd_identity", "homd_target"]]
    agg["rep_homd_identity"] = agg["rep_derep_id"].map(rep_map["homd_identity"])
    agg["rep_homd_target"] = agg["rep_derep_id"].map(rep_map["homd_target"])

    # support_score (v2 ranking)
    agg["support_score"] = agg["max_subject_prevalence"] * agg["n_bioprojects_total"] * agg["n_regions"]

    # column order
    first = ["cluster_id", "n_asvs", "n_refs_in_cluster", "rep_derep_id",
             "member_derep_ids", "annotation", "annotation_level", "annotation_basis",
             "cluster_novelty_class", "candidate_novel",
             "n_covered", "n_covered_safety", "any_covered", "any_covered_safety",
             "max_subject_prevalence", "max_prevalence", "n_bioprojects_total",
             "n_continents", "continents", "n_regions", "regions",
             "total_reads_sum", "n_contaminated_asvs", "any_contamination",
             "clean_cluster", "support_score", "rep_homd_identity", "rep_homd_target"]
    rest = [c for c in agg.columns if c not in first]
    agg = agg[first + rest].sort_values("support_score", ascending=False).reset_index(drop=True)

    out = PIPE_V3 / "02_clusters_aggregated.tsv"
    agg.to_csv(out, sep="\t", index=False)
    log(f"  saved {out} ({len(agg):,} rows)")

    # 7. Summary
    n_cap = int((agg["cluster_novelty_class"] == "homd_captured").sum())
    n_unc = int((agg["cluster_novelty_class"] == "homd_uncaptured").sum())
    n_cand = int(agg["candidate_novel"].sum())
    log(f"\n=== Cluster aggregation summary ===")
    log(f"clusters: {len(agg):,} | homd_captured: {n_cap:,} | homd_uncaptured: {n_unc:,}")
    log(f"candidate_novel (uncaptured & subjects>=10): {n_cand:,}")
    log(f"clean clusters: {int(agg['clean_cluster'].sum()):,}")

    summary = {
        "n_clusters": int(len(agg)),
        "n_asvs": int(len(df)),
        "by_novelty": {"homd_captured": n_cap, "homd_uncaptured": n_unc},
        "candidate_novel": n_cand,
        "clean_clusters": int(agg["clean_cluster"].sum()),
        "annotation_level_counts": agg["annotation_level"].value_counts().to_dict(),
        "subject_gate": "max_subject_prevalence >= 10",
        "novelty_method": "any member ASV covered (nearest HOMD ref <= 0.03 on GG2 tree) "
                          "or rep HOMD identity >= 97%",
    }
    with open(PIPE_V3 / "02_summary.json", "w") as f:
        json.dump(summary, f, indent=2)
    log("  saved 02_summary.json")
    log("Done!")


if __name__ == "__main__":
    main()
