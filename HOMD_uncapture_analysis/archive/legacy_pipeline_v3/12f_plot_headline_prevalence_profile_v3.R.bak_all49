#!/usr/bin/env Rscript
# pipeline_v3: Supported-catalog prevalence profile — per-CLUSTER layout with a
# species-level annotation distance gate (<= 0.03).
# 12d_headline_profile_v3.tsv is one row per derep ASV (900 rows / 486 clusters,
# singleton clusters included).
# Display unit = CLUSTER (cluster-level annotation kept), NOT merged by annotated
# species. Only clusters whose species-level tree annotation passes the distance
# gate (max annotation_distance over member ASVs <= 0.03) are shown, so far-away
# singleton "species calls" (e.g. deep insertions labelled with a distant
# ancestor's species) are excluded.
# y-axis = cluster (labelled "cluster_id | species") ranked by max subject prevalence.
# Panels: No. derep ASVs, BioProjects (union), log10(reads), HOMD identity bins,
# HOMD capture (color block), Continents, Regions,
# and per-ASV subject prevalence (boxplot + jitter; points colored by
# cluster-member vs singleton origin).
suppressPackageStartupMessages({
  library(ggplot2)
  library(aplot)
})

PIPE_V3 <- "/beegfs/huangxiaochang/global_oral/global-oral-microbiome/HOMD_uncapture_analysis/pipeline_v3"
FIGOUT  <- file.path(PIPE_V3, "analysis_report", "figs")
dir.create(FIGOUT, showWarnings = FALSE, recursive = TRUE)

split_values <- function(x) {
  if (is.na(x) || x == "" || x == "NA" || x == "nan") return(character())
  vals <- unlist(strsplit(as.character(x), ";", fixed = TRUE))
  vals[vals != "" & vals != "NA" & vals != "nan"]
}

clean <- function(x) {
  x <- as.character(x)
  x[is.na(x) | x == "" | x == "Unassigned"] <- NA_character_
  x
}

message("[12f_v3] loading species-annotated supported profile (one row per derep ASV)")
asv <- read.delim(file.path(PIPE_V3, "12d_headline_profile_v3.tsv"),
                  sep = "\t", header = TRUE, check.names = FALSE, stringsAsFactors = FALSE)
asv$subject_prevalence <- suppressWarnings(as.numeric(asv$subject_prevalence))
asv$homd_identity <- suppressWarnings(as.numeric(asv$homd_identity))
asv$cluster_total_reads <- suppressWarnings(as.numeric(asv$cluster_total_reads))
asv$annotation_distance <- suppressWarnings(as.numeric(asv$annotation_distance))

# ---- filter: species-level tree annotation + distance gate <= 0.03
#      (gate applies ONLY to singleton clusters; clusters with reference
#       members and other multi-ASV clusters are kept as-is) ----
asv <- asv[!is.na(asv$annotation_level) & asv$annotation_level == "species", ]
asv <- asv[!is.na(asv$annotation) & asv$annotation != "" & asv$annotation != "nan", ]
asv$is_singleton <- suppressWarnings(as.numeric(asv$cluster_id)) < 0 & !is.na(suppressWarnings(as.numeric(asv$cluster_id)))
asv <- asv[!asv$is_singleton | (!is.na(asv$annotation_distance) & asv$annotation_distance <= 0.03), ]
asv$species <- asv$annotation
if (nrow(asv) == 0) stop("no clusters pass the distance gate")

# ---- aggregate per CLUSTER (do not merge species) ----
cl <- do.call(rbind, lapply(split(seq_len(nrow(asv)), asv$cluster_id), function(idx) {
  d <- asv[idx, ]
  rep_i <- idx[which.max(d$subject_prevalence)]
  data.frame(
    cluster_id = d$cluster_id[1],
    species = d$species[1],
    annotation_distance = max(d$annotation_distance, na.rm = TRUE),
    max_subject_prevalence = max(d$subject_prevalence, na.rm = TRUE),
    n_asvs = nrow(d),
    is_singleton = d$is_singleton[1],
    n_bioprojects = length(unique(unlist(lapply(d$bioprojects, split_values)))),
    total_reads = max(d$cluster_total_reads, na.rm = TRUE),
    regions = d$cluster_regions[1],
    continents = d$cluster_continents[1],
    homd_identity = d$homd_identity[rep_i],
    homd_capture = d$homd_capture[1],
    stringsAsFactors = FALSE)
}))
cl$label <- paste0(cl$cluster_id, " | ", cl$species)
cl$log10_total_reads <- log10(cl$total_reads + 1)

cl <- cl[order(-cl$max_subject_prevalence, -cl$n_asvs, -cl$n_bioprojects, cl$cluster_id), ]
cl$rank <- seq_len(nrow(cl))
cl$rank_f <- factor(cl$rank, levels = rev(cl$rank))

identity_bins <- c("<90%", "90-95%", "95-97%", "97-99%", ">=99%")
cl$homd_identity_bin <- factor(
  cut(cl$homd_identity, breaks = c(-Inf, 90, 95, 97, 99, Inf),
      labels = identity_bins, right = FALSE), levels = identity_bins)

n  <- nrow(cl)
n_sing <- sum(cl$is_singleton)
message(sprintf("[12f_v3] retained %d species-annotated clusters (dist <= 0.03): %d derep ASVs incl. %d singletons",
                n, sum(cl$n_asvs), n_sing))

# ---- adaptive sizing / fonts ----
base_sz   <- ifelse(n >= 200, 6.5, ifelse(n >= 100, 8, 9))
ylab_sz   <- ifelse(n >= 200, 2.0, ifelse(n >= 100, 3.2, 4.5))
xlab_sz   <- ifelse(n >= 200, 5.5, 7)
row_in    <- ifelse(n >= 200, 0.058, ifelse(n >= 100, 0.075, 0.18))
fig_h     <- max(4.5, 1.8 + n * row_in)
thin      <- ifelse(n > 80, ceiling(n / 80), 1)

asv_df <- data.frame(rank_f = cl$rank_f, track = "No. derep ASVs", value = cl$n_asvs)
bioproject_df <- data.frame(rank_f = cl$rank_f, track = "No. bioprojects", value = cl$n_bioprojects)
reads_df <- data.frame(rank_f = cl$rank_f, track = "log10 reads", value = cl$log10_total_reads)
homd_df <- data.frame(rank_f = cl$rank_f, track = "HOMD id", identity_bin = cl$homd_identity_bin)

all_continents <- sort(unique(unlist(lapply(cl$continents, split_values))))
continent_df <- do.call(rbind, lapply(seq_len(nrow(cl)), function(i) {
  vals <- split_values(cl$continents[i])
  data.frame(rank_f = cl$rank_f[i], track = all_continents, detected = all_continents %in% vals)
}))
continent_df$track <- factor(continent_df$track, levels = all_continents)

all_regions <- sort(unique(unlist(lapply(cl$regions, split_values))))
region_df <- do.call(rbind, lapply(seq_len(nrow(cl)), function(i) {
  vals <- split_values(cl$regions[i])
  data.frame(rank_f = cl$rank_f[i], track = all_regions, detected = all_regions %in% vals)
}))
region_df$track <- factor(region_df$track, levels = all_regions)

theme_h <- theme_minimal(base_size = base_sz) +
  theme(panel.grid = element_blank(),
        axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5,
                                   size = ifelse(n > 150, 4.5, 6), color = "#222222"),
        axis.ticks.x = element_blank(),
        axis.title = element_blank(),
        plot.margin = margin(2, 4, 2, 2))

# ---- per-ASV subject prevalence: boxplot + jitter, colored by origin ----
rank_map <- setNames(cl$rank_f, cl$cluster_id)
prev_rank <- rank_map[match(asv$cluster_id, names(rank_map))]
prev_long <- data.frame(rank_f = factor(prev_rank, levels = levels(cl$rank_f)),
                        subject_prevalence = asv$subject_prevalence,
                        origin = ifelse(asv$is_singleton, "singleton cluster", "multi-ASV cluster"))
origin_colors <- c("multi-ASV cluster" = "#2F5D62", "singleton cluster" = "#C96B3C")
p_prev <- ggplot(prev_long, aes(y = rank_f, x = subject_prevalence)) +
  geom_boxplot(fill = "#2F5D62", color = "#1E3B40", outlier.shape = NA, width = 0.7, alpha = 0.30) +
  geom_jitter(aes(color = origin), width = 0.10, height = 0.10, size = 0.5, alpha = 0.55) +
  scale_color_manual(values = origin_colors, name = "ASV origin") +
  labs(y = NULL, x = "Subject prevalence (per-ASV)") +
  theme_classic(base_size = base_sz) +
  theme(axis.text.y = element_blank(),
        axis.title.x = element_text(size = xlab_sz),
        legend.position = "bottom",
        legend.title = element_text(size = 5.5),
        legend.text = element_text(size = 4.8),
        legend.key.size = unit(0.16, "cm"),
        legend.margin = margin(0, 0, 0, 0),
        plot.margin = margin(2, 4, 2, 2))

mk_tile <- function(d, fill_var, scale_fun, show_y = FALSE) {
  p <- ggplot(d, aes(y = rank_f, x = track, fill = !!sym(fill_var))) +
    geom_tile(width = 0.88, height = 0.78) +
    scale_fun +
    theme_h +
    theme(axis.text.y = if (show_y) element_text(size = ylab_sz, color = "#222222")
                         else element_blank(),
          legend.position = "bottom",
          legend.box = "horizontal",
          legend.title = element_text(size = 5.5),
          legend.text = element_text(size = 4.8),
          legend.key.size = unit(0.16, "cm"),
          legend.margin = margin(0, 0, 0, 0))
  p
}

# thin axis labels when many clusters
axis_labs <- setNames(rep("", n), as.character(cl$rank))
axis_labs[seq(1, n, by = thin)] <- cl$label[seq(1, n, by = thin)]

p_asv <- mk_tile(asv_df, "value",
                 scale_fill_gradient(low = "#F1F3F1", high = "#5B6E8C", name = "No. derep ASVs"),
                 show_y = TRUE) +
  scale_y_discrete(labels = axis_labs) +
  labs(title = sprintf("Species-annotated supported clusters, ann. distance <= 0.03 (%d clusters, %d derep ASVs incl. %d singletons)",
                       n, sum(cl$n_asvs), n_sing),
       subtitle = "one row per cluster (NOT merged per species) | ordered by max subject-level prevalence | box = per-ASV subject prevalence, dots colored by cluster vs singleton origin | HOMD capture as color column") +
  theme(plot.title = element_text(face = "bold", size = ifelse(n > 150, 8.5, 9)),
        plot.subtitle = element_text(size = ifelse(n > 150, 6.5, 7)))
p_bp <- mk_tile(bioproject_df, "value",
                scale_fill_gradient(low = "#F1F3F1", high = "#244C5A", name = "No. bioprojects"))
p_reads <- mk_tile(reads_df, "value",
                   scale_fill_gradient(low = "#F6F1E8", high = "#9A4F2D", name = "log10 reads"))
identity_palette <- c("<90%" = "#D73027", "90-95%" = "#FC8D59", "95-97%" = "#FEE08B",
                      "97-99%" = "#91BFDB", ">=99%" = "#1A9850")
p_homd <- mk_tile(homd_df, "identity_bin",
                  scale_fill_manual(values = identity_palette, drop = TRUE, name = "HOMD id"))
capture_df <- data.frame(rank_f = cl$rank_f, track = "HOMD capture", capture = cl$homd_capture)
p_capture <- mk_tile(capture_df, "capture",
                     scale_fill_manual(values = c("homd_captured" = "#8ECAE6", "homd_uncaptured" = "#E15759"),
                                       name = "HOMD capture"))
p_continent <- mk_tile(continent_df, "detected",
                       scale_fill_manual(values = c(`FALSE` = "#F3F3F3", `TRUE` = "#C96B3C"),
                                         name = "Continents"))
p_region <- mk_tile(region_df, "detected",
                    scale_fill_manual(values = c(`FALSE` = "#F3F3F3", `TRUE` = "#4A7C59"),
                                      name = "Regions"))

combined <- p_asv %>%
  insert_right(p_bp, width = 0.15) %>%
  insert_right(p_reads, width = 0.15) %>%
  insert_right(p_homd, width = 0.15) %>%
  insert_right(p_capture, width = 0.15) %>%
  insert_right(p_continent, width = 0.55) %>%
  insert_right(p_region, width = 0.75) %>%
  insert_right(p_prev, width = 0.85)
combined$width <- c(0.17, 0.15, 0.15, 0.15, 0.17, 0.55, 0.75, 0.85)

out_base <- file.path(FIGOUT, "fig_v3_headline_prevalence_profile")
ggsave(paste0(out_base, ".pdf"), combined, width = 8.0, height = fig_h, device = cairo_pdf,
       limitsize = FALSE)
ggsave(paste0(out_base, ".png"), combined, width = 8.0, height = fig_h, dpi = 150,
       limitsize = FALSE)
cat(sprintf("Saved: %s.png / .pdf (height %.1f in, %d clusters)\nDone!\n",
            out_base, fig_h, n))
