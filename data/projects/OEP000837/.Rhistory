# Create a uniform metadata dataframe
metadata <- data.frame(
BioProject = "OEP000837",
Run = initial_meta$run_id,
sample_name = initial_meta$sample_name,
Age = NA,
BMI = NA,
Sex=NA,
Region = "V3-V4",
Platform = "Illumina MiSeq",
Country = "China",
#Site = "Saliva",
public_time = "2020-04-14",
stringsAsFactors = FALSE
)
metadata<-unique(metadata)
# Add information obtained from the publication
metadata$PCR_primers <- "338F-806R"
metadata$title <- "Oral Microbiota Analysis of Tissue Pairs and Saliva Samples From Patients With Oral Squamous Cell Carcinoma A Pilot Study"
metadata$Disease_study <- "YES"
# Assign disease status based on sample_name patterns
metadata<-metadata%>%
mutate(Status=case_when(grepl("TY",sample_name)~"OSCC_Saliva",grepl("T|t",sample_name)~"OSCC_Tumor",grepl("C",sample_name)~"Normal Paracancerous Tissue"))
#get subjects id according to sample id
metadata<-metadata%>%
mutate(Site=case_when(grepl("TY",sample_name)~"Saliva",grepl("T|t",sample_name)~"Tumor",grepl("C",sample_name)~"Paracancerous Tissue"))
metadata$sample_name<-gsub("C|T|TY|t","",metadata$sample_name)
#get subjects id with Saliva available
keep_subjects<-subset(metadata,Site %in% "Saliva")
#remove subjects without Saliva samples
metadata<-subset(metadata,sample_name %in% keep_subjects$sample_name)
#get subjects sampling counts
sample_counts <- table(metadata$sample_name)
# Create matched_samples column, any subjects have >=2 samples will be label "YES", otherwise "NO"
metadata$matched_samples <- ifelse(metadata$sample_name %in% names(sample_counts[sample_counts >= 2]), "YES", "NO")
# Check the number of unique runs and sample names
print(paste("Number of unique runs:", length(unique(metadata$Run))))
print(paste("Number of unique sample names:", length(unique(metadata$sample_name))))
# Select columns for visualization
plot_data <- metadata %>%
select(-BioProject, -Run, -sample_name, -title)
# Function to create simple plots for each column
create_simple_plots <- function(data) {
plots <- list()
for (col in colnames(data)) {
# Check if the column is all NA
if (all(is.na(data[[col]]))) {
# Create an empty plot with text indicating all NA
p <- ggplot() +
annotate("text", x = 0.5, y = 0.5, label = "this column is NA", size = 6) +
labs(title = col) +
theme_void()
} else if (is.numeric(data[[col]])) {
# Numeric variable: histogram
p <- ggplot(data, aes(x = .data[[col]])) +
geom_histogram(fill = "blue", alpha = 0.6, bins = 20, na.rm = TRUE) +
labs(title = col) +
theme_minimal()
} else {
# Categorical variable: bar plot (remove NA values)
count_data <- as.data.frame(table(data[[col]], useNA = "ifany"))
p <- ggplot(count_data, aes(x = reorder(Var1, -Freq), y = Freq)) +
geom_col(fill = "red", alpha = 0.6) +
labs(title = col, x = NULL, y = "Count") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 15, hjust = 1))
}
plots[[col]] <- p
}
return(plots)
}
# Generate and arrange plots
plots <- create_simple_plots(plot_data)
p<-plot_grid(plots$Age,
plots$BMI,
plots$Sex,
plots$Region,
plots$Platform,
plots$Country,
plots$Site,
plots$public_time,
plots$PCR_primers,
plots$Disease_study,
plots$Status,
plots$matched_samples,# add
ncol = 3, align = "hv", axis = "lb")
ggsave("Metadata_Summary.png", plot = p, width = 8, height = 6, dpi = 150)
knitr::include_graphics("Metadata_Summary.png")
