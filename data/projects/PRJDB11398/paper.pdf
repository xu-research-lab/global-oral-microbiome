    <rdf:Description dc:format="application/pdf" pdf:Keywords="gingivitis; periodontitis; metatranscriptome; co-occurrence network; oral microbiome; dysbiosis" pdf:Producer="Adobe LiveCycle PDF Generator; modified using iTextÂ® 5.5.13.2 Â©2000-2020 iText Group NV (AGPL-version)" rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:pdf="http://ns.adobe.com/pdf/1.3/" xmlns:terms="http://purl.org/dc/terms/" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmp:CreateDate="2020-11-17T00:11:24+05:30" xmp:MetadataDate="2021-10-23T22:11:00+05:30" xmp:ModifyDate="2021-10-23T22:11:00+05:30">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Discrimination of Bacterial Community Structures among Healthy, Gingivitis, and Periodontitis Statuses through Integrated Metatranscriptomic and Network Analyses</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/mSystems.00886-21</rdf:li>
        </rdf:Alt>
      </dc:identifier>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Takashi Nemoto</rdf:li>
          <rdf:li>Takahiko Shiba</rdf:li>
          <rdf:li>Keiji Komatsu</rdf:li>
          <rdf:li>Takayasu Watanabe</rdf:li>
          <rdf:li>Masahiro Shimogishi</rdf:li>
          <rdf:li>Masaki Shibasaki</rdf:li>
          <rdf:li>Tatsuro Koyanagi</rdf:li>
          <rdf:li>Takahiko Nagai</rdf:li>
          <rdf:li>Sayaka Katagiri</rdf:li>
          <rdf:li>Yasuo Takeuchi</rdf:li>
          <rdf:li>Takanori Iwata</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Research Article</rdf:li>
          <rdf:li xml:lang="x-repair">Research Article</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>gingivitis</rdf:li>
          <rdf:li>periodontitis</rdf:li>
