# =============================================================
# Curation Notes - PRJEB35824
# subject_id : NA — OMIC naming encodes cohort/batch info, not individual subject identity; cannot link same person across visits
# age        : Derived from visit number in Submitter_Id; 1=2days(~0.0055yr), 2=3mo(0.25yr), 3=18mo(1.5yr), 4=3yr(3), 5=5yr(5)
# age_info   : NA — specific year values available in age column
# sex        : Not available in deposited metadata
# bmi        : Not available
# platform   : Paper Methods — Illumina MiSeq (loaded onto MiSeq cartridges)
# region     : Paper abstract + Methods — V3-V4 region of 16S rRNA gene
# pcr_primers: Paper Methods — 341F-806R (341F: ACGGGAGGCAGCAG; 806R: GGACTACHVGGGTWTCTAAT)
# site       : From initial_meta column 'tissue_type'; all deposited samples = "saliva"
# site_group : "oral" for all (saliva)
# country    : From initial_meta 'geo_loc_name_country' = "Sweden"
# disease_study : "no" — healthy infants and healthy young adults only
# status     : NA — all healthy participants
# is_time_series: "yes" — same children repeatedly sampled at 5 chronologically ordered timepoints (2d,3m,18m,3y,5y)
# controls   : None in deposited metadata
# non-human  : None; all Organism = "Homo sapiens"
# notes      : Only children samples (visits 1-5) deposited; 18-year adult samples withheld per GDPR
# =============================================================
# Load libraries
library(dplyr)
library(ggplot2)
library(cowplot)
# (1) Setting working directory
# EDIT HERE: change project_id for each study
project_id <- "PRJEB35824"
base_dir <- "D:/YL2025/2026/global-oral-github-YL-v2/global-oral-microbiome/data/projects/"
setwd(file.path(base_dir, project_id))
# (2) Loading raw SRA metadata file
sra_file <- "SraRunTable.csv"
initial_meta <- read.csv(sra_file, header = TRUE)
# (3) OPTIONAL: If extra metadata (e.g., Table.x or supplemental materials) are available from the article, you may need to merge the file with initial_meta manually. Below is example code for merging. Depending on the specific case of each study, you can customize the code as needed.
# supp_table <- read.csv("supplemental_table.csv", header = TRUE)
# initial_meta <- left_join(initial_meta, supp_table, by = merge_col_name)
View(initial_meta)
# (1) Read the article in the following order: abstract, the beginning of the results section, and the methods. Understand the sample size, experimental design, and disease group overview. Clarify the sampling sites; for oral and gut samples, specify the exact sites like supragingival plaque, tongue, etc.
# (2) IMPORTANT: MUST go through each column of initial_meta
# head(initial_meta, 10)
# IMPORTANT: Check the unique values in the column of interest or query column.
# lapply(initial_meta[c('tissue_type')], table)          # site: all "saliva"
# table(initial_meta$Organism)                           # organism: all "Homo sapiens"
# table(initial_meta$geo_loc_name_country)               # country: all "Sweden"
# table(initial_meta$Instrument)                         # instrument: all "Illumina MiSeq"
# unique(initial_meta$Submitter_Id)                      # subject/visit pattern: OMIC{subject}-{seq}-{visit}-swab
# (1) EDIT HERE: Parameter setup
control_column <- ""   # column name in initial_meta; no control samples in deposited metadata
# unique(initial_meta[[control_column]])
control_keywords <- c()     # Enter exact keywords
species_column <- "Organism"          # column name in initial_meta
unique(initial_meta[[species_column]])
non_human_keywords <- c()            # All samples are Homo sapiens; no non-human filtering needed
# (2) Remove controls and non-human samples. DO NOT need to modify code in this part, just run it.
n_samples <- nrow(initial_meta)
# Control evaluation
if (length(control_keywords) > 0) {
if (is.null(control_column) || control_column == "") {
stop("Error: control_keywords provided but control_column is missing.")
}
if (!(control_column %in% colnames(initial_meta))) {
stop(sprintf("Error: Column '%s' not found in initial_meta.", control_column))
}
control_pattern <- paste(control_keywords, collapse = "|")
control_text <- initial_meta[[control_column]]
is_control <- grepl(control_pattern, control_text)
} else {
is_control <- rep(FALSE, n_samples)
}
# Non-human evaluation
if (length(non_human_keywords) > 0) {
if (is.null(species_column) || species_column == "") {
stop("Error: non_human_keywords provided but species_column is missing.")
}
if (!(species_column %in% colnames(initial_meta))) {
stop(sprintf("Error: Column '%s' not found in initial_meta.", species_column))
}
non_human_pattern <- paste(non_human_keywords, collapse = "|")
species_text <- initial_meta[[species_column]]
is_non_human <- grepl(non_human_pattern, species_text)
} else {
is_non_human <- rep(FALSE, n_samples)
}
# Execute removal
samples_to_remove <- is_control | is_non_human
initial_meta <- initial_meta[!samples_to_remove, ]
cat("Initial samples counts:",n_samples,"\n")
cat("Removed control samples:", sum(is_control), "\n")
cat("Removed non-human samples:", sum(is_non_human), "\n")
cat("Total samples removed ", sum(samples_to_remove), "\n")
cat("Remaining samples after Step 2:", nrow(initial_meta), "\n")
# Extract columns from initial_meta as follows: (1) No modification needed -> extract directly. (2) Modification needed -> create a new column with the prefix raw_ and mark the original column as "pending". (3) Need to find or determine based on the article.
metadata <- data.frame(
bioproject = initial_meta$BioProject,
sample_id = initial_meta$Run,
# OMIC naming convention (e.g., OMIC7.1-1-1-swab) uses a prefix that encodes
# cohort/batch info (e.g., "7.", "10.") rather than individual subject identity.
# The same prefix appears in different visits with non-continuous seq numbers,
# making it impossible to link samples from the same person across timepoints.
# Subject ID set to NA - cannot be determined from deposited metadata.
subject_id = initial_meta$Run,
# Visit number extracted from Submitter_Id to derive approximate age per sample
raw_visit = as.integer(sub("^OMIC.+-[0-9]+-(\\d+)-swab$", "\\1", initial_meta$Submitter_Id)),
age = "pending",
age_info = NA,  # age column filled from visit number; no additional range info needed
bmi = NA,
sex = NA_character_,  # Sex not available in deposited metadata
sequencing_region = "V3-V4",  # From paper abstract: "sequencing of the v3-v4 region of the 16S rRNA gene"
platform = "Illumina MiSeq",  # From paper Methods: "loaded onto MiSeq cartridges (Illumina, San Diego, CA)"
country = initial_meta$geo_loc_name_country,
site = initial_meta$tissue_type,  # All deposited samples: "saliva" (swab-collected from children)
site_group = "pending",
public_time = initial_meta$ReleaseDate,
pcr_primers = "341F-806R",  # From paper Methods: 341F (ACGGGAGGCAGCAG) and 806R (GGACTACHVGGGTWTCTAAT)
title = "A longitudinal study of the development of the saliva microbiome in infants 2 days to 5 years compared to the microbiome in adolescents",  # From paper
disease_study = "no",  # Healthy cohort: healthy infants (n=206) and healthy young adults (n=175)
status = "HC",  # All participants are healthy; no disease groups
matched_samples = "pending",
is_time_series = "yes",  # Same children repeatedly sampled at 5 chronologically ordered timepoints: 2d, 3m, 18m, 3y, 5y
stringsAsFactors = FALSE
)
metadata$public_time <- as.Date(metadata$public_time)
# (1) Handle the columns with the `raw_` prefix.
# In this part, you need to customize the code based on the situation of the raw_ columns to obtain the content of the target columns. IMPORTANT: Add comments if the modification is not straightforward!!
# Map visit number to age in years (visit encodes study design timepoint)
# Visit 1 = 2 days (~0 yr), Visit 2 = 3 months (~0.25 yr), Visit 3 = 18 months (~1.5 yr),
# Visit 4 = 3 years, Visit 5 = 5 years
metadata <- metadata %>%
mutate(age = case_when(
raw_visit == 1 ~ 2/365.25,  # ~0.0055 yr (2 days old, avoid 0 for log/regression)
raw_visit == 2 ~ 0.25,
raw_visit == 3 ~ 1.5,
raw_visit == 4 ~ 3,
raw_visit == 5 ~ 5,
TRUE ~ NA_real_
))
# (2) Filling the 'site_group' and 'matched_samples' columns
# editing site_group
unique(metadata$site)
# EDIT HERE: add oral sites
Oral_site = c("saliva")
# EDIT HERE: add gut sites
Gut_site = c()
# just run
metadata <- metadata %>%
mutate(site_group = case_when(
site %in% Oral_site ~ "oral",
site %in% Gut_site ~ "gut",
TRUE ~ "other"
))
# editing matched_samples: NA because subject_id is unknown, cannot determine if samples are from same person
metadata$matched_samples <- NA_character_
# (3) check if there is pending value in metadata. If there is pending value, go on modify the metadata.
# Function to check if a column contains "pending"
has_pending <- function(col) {
if (is.character(col) || is.factor(col)) {
any(col == "pending", na.rm = TRUE)
} else {
FALSE
}
}
# Check for any pending value
any_pending_value <- any(sapply(metadata, has_pending))
if (!any_pending_value) {
message("Good! No cell contains the value 'pending'.")
} else {
pending_cols <- names(metadata)[sapply(metadata, has_pending)]
message("Columns containing 'pending': ", paste(pending_cols, collapse = ", "))
message("Please continue to resolve these pending columns!")
}
# Select columns for visualization, just run
plot_data <- metadata %>%
select(-bioproject, -sample_id, -subject_id, -title)
create_simple_plots <- function(data) {
plots <- list()
continuous_vars <- c("age", "bmi")
for (col in colnames(data)) {
if (all(is.na(data[[col]]))) {
p <- ggplot() +
annotate("text", x = 0.5, y = 0.5, label = "this column is NA", size = 6) +
labs(title = col) +
theme_void()
} else if (col %in% continuous_vars && is.numeric(data[[col]])) {
p <- ggplot(data, aes(x = .data[[col]])) +
geom_histogram(fill = "blue", alpha = 0.6, bins = 20, na.rm = TRUE) +
labs(title = col, x = col, y = "Count") +
theme_minimal()
} else {
count_data <- as.data.frame(table(data[[col]], useNA = "ifany"))
p <- ggplot(count_data, aes(x = reorder(Var1, -Freq), y = Freq)) +
geom_col(fill = "red", alpha = 0.6) +
labs(title = col, x = NULL, y = "Count") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 15, hjust = 1))
}
plots[[col]] <- p
}
return(plots)
}
# Generate and arrange plots
plots <- create_simple_plots(plot_data)
p <- plot_grid(plots$age,
plots$age_info,
plots$bmi,
plots$sex,
plots$site,
plots$site_group,
plots$sequencing_region,
plots$platform,
plots$country,
plots$pcr_primers,
plots$status,
plots$matched_samples,
ncol = 3, align = "hv", axis = "lb")
ggsave("Metadata_Summary.png", plot = p, width = 8, height = 6, dpi = 150)
# Insert Metadata_Summary.png into the current Rmd output
knitr::include_graphics("Metadata_Summary.png")
# Reorder the data frame
fixed_cols <- c("bioproject", "sample_id", "subject_id", "age", "age_info",
"bmi", "sex", "platform", "sequencing_region", "pcr_primers",
"country", "site", "site_group", "disease_study", "status",
"title", "public_time", "matched_samples", "is_time_series")
metadata <- metadata %>%
select(all_of(fixed_cols), everything())
# save metadata
# head(metadata)
write.csv(metadata, file = "metadata_v2.csv", quote = TRUE)
# Load libraries
library(dplyr)
library(ggplot2)
library(cowplot)
# (1) Setting working directory
# EDIT HERE: change project_id for each study
project_id <- "PRJNA779698"
base_dir <- "D:/YL2025/2026/global-oral-github-YL-v2/global-oral-microbiome/data/projects/"
setwd(file.path(base_dir, project_id))
# (2) Loading raw SRA metadata file
sra_file <- "SraRunTable.csv"
initial_meta <- read.csv(sra_file, header = TRUE)
# (3) OPTIONAL: If extra metadata (e.g., Table.x or supplemental materials) are available from the article, you may need to merge the file with initial_meta manually. Below is example code for merging. Depending on the specific case of each study, you can customize the code as needed.
# supp_table <- read.csv("supplemental_table.csv", header = TRUE)
# initial_meta <- left_join(initial_meta, supp_table, by = merge_col_name)
View(initial_meta)
# (1) Read the article in the following order: abstract, the beginning of the results section, and the methods. Understand the sample size, experimental design, and disease group overview. Clarify the sampling sites; for oral and gut samples, specify the exact sites like supragingival plaque, tongue, etc.
# (2) IMPORTANT: MUST go through each column of initial_meta
# head(initial_meta, 10)
# IMPORTANT: Check the unique values in the column of interest or query column.
# lapply(initial_meta[c('body_habitat', 'body_product', 'body_site')], table) # site
# lapply(initial_meta[c('common_name', 'env_biome', 'env_feature', 'env_matter', 'host_common_name', 'Organism', 'role', 'pet_farm_animal')], table) # organism: the dog sample counts in these columns are different! 512 in pet_farm_animal,217 in env_biome, env_feature and role, 210 in host_common_name. Majority rule, so we determine to use column role to filter dog samples
# table(initial_meta$host_subject_id) # subject id
# table(initial_meta$sequencing_meth..exp.) # output is pyrosequencing
# table(initial_meta$platform..exp.) # output is Illumina. according to the methods, Illumina is correct.
# table(initial_meta$target_subfragment..exp.)
# (1) EDIT HERE: Parameter setup
control_column <- "Library.Name"   # column name in initial_meta
# unique(initial_meta[[control_column]])
control_keywords <- c('none')     # Enter exact keywords
species_column <- "HOST"          # column name in initial_meta
unique(initial_meta[[species_column]])
non_human_keywords <- c("none")            # Enter exact keywords
seq_column <- 'Assay.Type'
non_16S_keywords <- c("RNA-Seq",'WGS')
# (2) Remove controls and non-human samples. DO NOT need to modify code in this part, just run it.
n_samples <- nrow(initial_meta)
# Control evaluation
if (length(control_keywords) > 0) {
if (is.null(control_column) || control_column == "") {
stop("Error: control_keywords provided but control_column is missing.")
}
if (!(control_column %in% colnames(initial_meta))) {
stop(sprintf("Error: Column '%s' not found in initial_meta.", control_column))
}
control_pattern <- paste(control_keywords, collapse = "|")
control_text <- initial_meta[[control_column]]
is_control <- grepl(control_pattern, control_text)
} else {
is_control <- rep(FALSE, n_samples)
}
# Non-human evaluation
if (length(non_human_keywords) > 0) {
if (is.null(species_column) || species_column == "") {
stop("Error: non_human_keywords provided but species_column is missing.")
}
if (!(species_column %in% colnames(initial_meta))) {
stop(sprintf("Error: Column '%s' not found in initial_meta.", species_column))
}
non_human_pattern <- paste(non_human_keywords, collapse = "|")
species_text <- initial_meta[[species_column]]
is_non_human <- grepl(non_human_pattern, species_text)
} else {
is_non_human <- rep(FALSE, n_samples)
}
#non-16S evaluation
if (length(non_16S_keywords) > 0) {
if (is.null(seq_column) || seq_column == "") {
stop("Error: non_human_keywords provided but seq_column is missing.")
}
if (!(seq_column %in% colnames(initial_meta))) {
stop(sprintf("Error: Column '%s' not found in initial_meta.", seq_column))
}
non_16S_pattern <- paste(non_16S_keywords, collapse = "|")
seq_text <- initial_meta[[seq_column]]
is_non_16S <- grepl(non_16S_pattern, seq_text)
} else {
is_non_16S <- rep(FALSE, n_samples)
}
# Execute removal
samples_to_remove <- is_control | is_non_human | is_non_16S
initial_meta <- initial_meta[!samples_to_remove, ]
cat("Initial samples counts:",n_samples,"\n")
cat("Removed control samples:", sum(is_control), "\n")
cat("Removed non-human samples:", sum(is_non_human), "\n")
cat("Removed non-16s samples:", sum(is_non_16S), "\n")
cat("Total samples removed ", sum(samples_to_remove), "\n")
cat("Remaining samples after Step 2:", nrow(initial_meta), "\n")
