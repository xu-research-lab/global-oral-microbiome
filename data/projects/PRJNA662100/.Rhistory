metadata$title <- "Oral Microbiota Perturbations Are Linked to High Risk for Rheumatoid Arthritis"
metadata$Disease_study <- "YES"
metadata <- metadata %>% mutate(Status=case_when(grepl("trim.sH",sample_name)~"H",grepl("trim.sp",sample_name)~"RA",grepl("trim.sR",sample_name)~"RA"))
metadata <- metadata %>%
mutate(Sex = case_when(
grepl("f",Sex)~"F",
grepl("m",Sex)~"M"
))
#extract subject id by remove prefix of sample_name
#metadata$sample_name <- gsub("T|CR|CS|C|N|S", "", metadata$sample_name)
# Check initial data distribution
cat("Initial sample distribution:\n")
table(metadata$sample_name)
table(metadata$Site)
# Calculate sampling frequency per subject
sample_counts <- table(metadata$sample_name)
cat("\nNumber of samples per subject:\n")
print(sample_counts)
# Create matched_samples column
metadata$matched_samples <- ifelse(metadata$sample_name %in% names(sample_counts[sample_counts >= 2]), "YES", "NO")
cat("\nMatched samples distribution:\n")
table(metadata$matched_samples)
# Identify samples for removal: single samples excluding saliva
single_samples <- names(sample_counts[sample_counts == 1])
samples_to_remove <- metadata$sample_name %in% single_samples & !(metadata$Site %in% c("saliva"))
cat("\nNumber of samples to be removed:", sum(samples_to_remove), "\n")
# Remove identified samples
metadata_clean <- metadata[!samples_to_remove, ]
cat("\nFinal sample distribution after cleaning:\n")
table(metadata_clean$sample_name)
table(metadata_clean$Site)
table(metadata_clean$matched_samples)
# Use cleaned dataset for subsequent analysis
metadata <- metadata_clean
# Check the number of unique runs and sample names
print(paste("Number of unique runs:", length(unique(metadata$Run))))
print(paste("Number of unique sample names:", length(unique(metadata$sample_name))))
# Select columns for visualization
plot_data <- metadata %>%
select(-BioProject, -Run, -sample_name, -title)
# Function to create simple plots for each column
create_simple_plots <- function(data) {
plots <- list()
for (col in colnames(data)) {
# Check if the column is all NA
if (all(is.na(data[[col]]))) {
# Create an empty plot with text indicating all NA
p <- ggplot() +
annotate("text", x = 0.5, y = 0.5, label = "this column is NA", size = 6) +
labs(title = col) +
theme_void()
} else if (is.numeric(data[[col]])) {
# Numeric variable: histogram
p <- ggplot(data, aes(x = .data[[col]])) +
geom_histogram(fill = "blue", alpha = 0.6, bins = 20, na.rm = TRUE) +
labs(title = col) +
theme_minimal()+scale_x_continuous(breaks = 50)
} else {
# Categorical variable: bar plot (remove NA values)
count_data <- as.data.frame(table(data[[col]], useNA = "ifany"))
p <- ggplot(count_data, aes(x = reorder(Var1, -Freq), y = Freq)) +
geom_col(fill = "red", alpha = 0.6) +
labs(title = col, x = NULL, y = "Count") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 15, hjust = 1))
}
plots[[col]] <- p
}
return(plots)
}
# Generate and arrange plots
plots <- create_simple_plots(plot_data)
p<-plot_grid(plots$Age,
plots$BMI,
plots$Sex,
plots$Region,
plots$Platform,
plots$Country,
plots$Site,
plots$public_time,
plots$PCR_primers,
plots$Disease_study,
plots$Status,
plots$matched_samples,# add
ncol = 3, align = "hv", axis = "lb")
ggsave("Metadata_Summary.png", plot = p, width = 8, height = 6, dpi = 150, bg = "white")
knitr::include_graphics("Metadata_Summary.png")
# Reorder columns to match the desired format
metadata <- metadata[, c(
"BioProject", "Run", "sample_name", "Age", "BMI", "Sex",
"Region", "Platform", "Country", "Site", "public_time",
"PCR_primers", "title", "Disease_study", "Status","matched_samples"
)]
# Export the uniform metadata to a CSV file
write.csv(metadata, file = "metadata.csv", quote = FALSE)
head(metadata)
