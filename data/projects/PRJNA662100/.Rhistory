update_dataframe <- function(df, id_col, condition_value, update_cols, update_values) {
condition_rows <- df[[id_col]] == condition_value
# 更新指定列的值
for (i in seq_along(update_cols)) {
df[condition_rows, update_cols[i]] <- update_values[i]
}
return(df)
}
