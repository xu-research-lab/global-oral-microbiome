      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Extent of Oralâ€“Gut Transmission of Bacterial and Fungal Microbiota in Healthy Chinese Adults</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/spectrum.02814-22</rdf:li>
