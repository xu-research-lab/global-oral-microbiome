      <dc:subject>
        <rdf:Bag>
          <rdf:li>oralâ€“gut microbiota axis</rdf:li>
          <rdf:li>16S</rdf:li>
          <rdf:li>ITS1</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li xml:lang="x-default">American Society for Microbiology</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:rightsHolder>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Cheung et al.</rdf:li>
        </rdf:Alt>
      </dc:rightsHolder>
      <dc:rights>
