      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Clinical Oral Condition Analysis and the Influence of Highly Active Antiretroviral Therapy on Human Salivary Microbial Community Diversity in HIV-Infected/AIDS Patients</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Peilin Cao; Yifan Zhang; Guangyan Dong; Hongkun Wu; Yuxiang Yang; Yi Liu</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The purpose of this study was to assess the clinical oral status and investigate the effect of highly active antiretroviral therapy (HAART) on oral flora diversity in human immunodeficiency virus (HIV)-infected/acquired immune deficiency syndrome (AIDS) patients</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
